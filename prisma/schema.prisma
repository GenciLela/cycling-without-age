generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id
  name                String    @db.Text
  email               String
  emailVerified       Boolean   @default(false)
  image               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  role                String?   @db.Text
  banned              Boolean?  @default(false)
  banReason           String?   @db.Text
  banExpires          DateTime?
  birthDate DateTime? @db.Date
  gender    Gender?
  locale    String?   @db.VarChar(5)
  residence Residence?
  address   String?    @db.Text
  latitude  Float?
  longitude Float?
  managesOthers Boolean @default(false)
  notifyEmail Boolean @default(false)
  notifyPush  Boolean @default(false)
  consentSafetyAt DateTime?
  consentDataAt   DateTime?
  passkeyPromptedAt    DateTime?
  pilotNextStepsSeenAt DateTime?
  welcomeEmailSentAt DateTime?
  createdByUserId String?
  createdBy       User?   @relation("createdUsers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers    User[]  @relation("createdUsers")
  claimedAt       DateTime?
  helperName         String? @db.Text
  helperRelationship String? @db.Text
  helperContact      String? @db.Text
  sessions            Session[]
  accounts            Account[]
  passkeys            Passkey[]
  members             Member[]
  invitations         Invitation[]
  countryAdminOf      CountryAdmin[]
  applications        ChapterApplication[] @relation("applicant")
  decidedApplications ChapterApplication[] @relation("decider")
  passengers          Passenger[]          @relation("manages")
  passengerProfile    Passenger?           @relation("self")
  rideRequests        RideRequest[]        @relation("rideRequester")
  decidedRideRequests RideRequest[]        @relation("rideDecider")
  activityEvents      ActivityEvent[]      @relation("activitySubject")
  activityActions     ActivityEvent[]      @relation("activityActor")

  @@unique([email])
  @@unique([phoneNumber])
  @@index([createdByUserId])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?  @db.Text
  activeOrganizationId String?  @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text

  @@index([userId])
  @@index([credentialID(length: 191)])
  @@map("passkey")
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @db.Text
  slug        String
  logo        String?      @db.Text
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  metadata    String?      @db.Text
  members     Member[]
  invitations Invitation[]

  countryId    String
  country      Country              @relation(fields: [countryId], references: [id])
  city         String               @db.Text
  address      String?              @db.Text
  careHomeName String?              @db.Text
  latitude     Float
  longitude    Float
  applications ChapterApplication[]
  passengers   Passenger[]
  rideRequests RideRequest[]
  events       ActivityEvent[]
  serviceRadiusKm Int @default(10)

  @@unique([slug])
  @@index([countryId])
  @@index([latitude, longitude])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email(length: 191)])
  @@map("invitation")
}

enum ChapterRole {
  admin
  pilot
  passenger
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model Country {
  id        String   @id @default(cuid())
  name      String   @db.Text
  code      String   @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Organization[]
  admins   CountryAdmin[]

  @@unique([code])
  @@map("country")
}

model CountryAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, countryId])
  @@index([countryId])
  @@map("country_admin")
}

model ChapterApplication {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role            ChapterRole       @default(pilot)
  status          ApplicationStatus @default(pending)
  message         String?           @db.Text
  decidedByUserId String?
  decidedBy       User?             @relation("decider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?           @db.Text
  approvalSeenAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId, status])
  @@index([decidedByUserId])
  @@map("chapter_application")
}

enum Gender {
  female
  male
  other
}

enum Residence {
  careHome
  home
}

model Passenger {
  id              String       @id @default(cuid())
  chapterId       String
  chapter         Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  managedByUserId String
  managedBy       User         @relation("manages", fields: [managedByUserId], references: [id], onDelete: Cascade)
  userId          String?      @unique
  user            User?        @relation("self", fields: [userId], references: [id], onDelete: SetNull)

  firstName String   @db.Text
  lastName  String   @db.Text
  birthDate DateTime @db.Date
  gender    Gender

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rideRequests RideRequest[]

  @@index([chapterId])
  @@index([managedByUserId])
  @@map("passenger")
}

enum RideTimeOfDay {
  morning
  afternoon
  any
}

enum RideRequestStatus {
  requested
  confirmed
  declined
  cancelled
  completed
}

/// A passenger's wish for a ride, not yet a Ride. It is phase 1 of the CWA ride
/// lifecycle — the Ride Request List a scheduler works from — so it carries a
/// preferred day and a rough part of that day rather than a slot: a chapter
/// operating calendar does not exist yet, and promising a time we cannot keep is
/// worse than asking for one we can move.
model RideRequest {
  id        String       @id @default(cuid())
  chapterId String
  chapter   Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  /// Who filled in the form — the passenger themselves, or the relative who
  /// manages them. Both are kept: the roster names the passenger, the chapter
  /// calls back whoever asked.
  requestedByUserId String
  requestedBy       User   @relation("rideRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  preferredDate DateTime      @db.Date
  timeOfDay     RideTimeOfDay
  note          String?       @db.Text

  status      RideRequestStatus @default(requested)
  cancelledAt DateTime?

  /// Who answered, and when. `declineReason` is shown to the passenger word for
  /// word, so it is written by a person and never generated.
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("rideDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  declineReason   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, preferredDate])
  @@index([passengerId, preferredDate])
  @@index([requestedByUserId])
  @@index([decidedByUserId])
  @@map("ride_request")
}

enum ActivityType {
  applicationSubmitted
  applicationApproved
  applicationRejected
  roleGranted
  roleRevoked
  memberRemoved
  emailSent
  countryAdminAppointed
  countryAdminRemoved
  accountCreated
  invited
  accountClaimed
  chapterCreated
  chapterUpdated
  chapterDeleted
}

model ActivityEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("activitySubject", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?         @relation("activityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type        ActivityType
  payload     Json?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([chapterId, createdAt])
  @@map("activity_event")
}
